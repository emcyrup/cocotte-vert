# ---- Docker Compose でのデプロイ時に必須（docs/deploy.md 参照）----
# DB コンテナのパスワード。openssl rand -hex 16 などで生成する
POSTGRES_PASSWORD=
# 公開ドメイン（standalone プロファイル利用時。例: line.example.com）
DOMAIN=

# DB 接続（Docker Compose 利用時は無視される。ローカル開発時のみ設定）
DATABASE_URL=postgres://user:pass@localhost:5432/cocotte_vert

# LINE Messaging API（テスト用チャネルの値を入れる。本番値をここに書かない）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LIFF（Phase 2 から使用）
LIFF_ID=
# ID トークン検証用チャネル ID。通常は LIFF_ID の先頭部分から自動導出されるため空で可
LIFF_CHANNEL_ID=

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# Claude API（Phase 4 から使用）
ANTHROPIC_API_KEY=

# 送信モード: dry_run | test | live
# live は環境変数ファイルに書かず、実行時に明示的に渡す運用とする
SEND_MODE=dry_run
# SEND_MODE=test のときの送信先 LINE userId
TEST_LINE_USER_ID=

DORMANT_DAILY_LIMIT=50
# 誕生日クーポンの URL（LINE 公式アカウントのクーポン機能で作成。空なら文面のみ）
BIRTHDAY_COUPON_URL=
# 月間通数の残数がこの値以下になったら Slack へ警告
QUOTA_WARN_REMAINING=300

# 管理画面（/admin）の Basic 認証。未設定なら管理画面は無効
ADMIN_USER=
ADMIN_PASSWORD=
# 外部予約システム取り込み API の Bearer トークン。未設定なら取り込み API は無効
# openssl rand -hex 24 などで生成する
INGEST_API_TOKEN=
TZ=Asia/Tokyo
PORT=3000
